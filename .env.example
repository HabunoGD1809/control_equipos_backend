# Copie este archivo a .env. Nunca publique .env ni los respaldos.
PROJECT_NAME="Control de Equipos API"
API_V1_STR=/api/v1

# Genere dos claves DIFERENTES: python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY="REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_96_CARACTERES"
REFRESH_TOKEN_SECRET_KEY="REEMPLAZAR_CON_OTRA_CLAVE_ALEATORIA_DE_96_CARACTERES"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Inicio nativo: 127.0.0.1:5433. Docker Compose configura db:5432 internamente.
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD="REEMPLAZAR_CON_SU_CONTRASENA_DE_POSTGRES"
POSTGRES_DB=control_equipos_dbv1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# bootstrap.py crea este usuario, asigna todos los permisos y exige cambiar la contraseña.
# Una ejecución posterior conserva la contraseña; --reset-password es explícito.
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD="REEMPLAZAR_CON_UNA_CONTRASENA_SEGURA"
MAX_FAILED_ATTEMPTS_BEFORE_LOCK=5

# background funciona sin Redis. Docker Compose usa celery y configura Redis.
REPORT_EXECUTION_MODE=background
# Requerido por Compose. Genere una clave aleatoria; Redis no tiene puerto público.
REDIS_PASSWORD="REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA"
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
UPLOADS_DIRECTORY=./uploads
MAX_FILE_SIZE_BYTES=10485760

# Correo opcional para la tarea SMTP; las notificaciones del sistema se muestran en la aplicación.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=usuario
# SMTP_PASSWORD=clave
# SMTP_FROM=informatica@example.com

# Almacenamiento S3 opcional para fotos de perfil privadas.
# Documentos y reportes usan UPLOADS_DIRECTORY (volumen persistente en Compose).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=
# AWS_ENDPOINT_URL=

# Las pruebas generan contraseñas aleatorias. No requieren cuentas TEST_* en producción.
